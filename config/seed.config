CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y

# Build every kmod so the firmware's own feed covers anything installed later
CONFIG_ALL_KMODS=y

# initramfs FIT for RAM boot testing (HTTP U-Boot "RAM boot" page)
CONFIG_TARGET_ROOTFS_INITRAMFS=y

CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y

# Keep the RAM-boot FIT small (stock U-Boot limit ~31 MiB, ours 128 MiB)
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
