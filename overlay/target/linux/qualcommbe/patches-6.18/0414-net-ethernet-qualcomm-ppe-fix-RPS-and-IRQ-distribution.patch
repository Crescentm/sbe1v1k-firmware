From: Dedrimer <13420015738@sina.cn>
Date: Sat, 15 Aug 2026 17:10:00 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: fix RPS and IRQ distribution

The RPS sysctl stores the requested core bitmap, but the hash mapping path
always rebuilds its CPU mask from EDMA_RX_DEFAULT_BITMAP. As a result,
writing rps_bitmap_cores reports the new value without changing the
hardware queue mapping.

The queue mapping also expects each EDMA ring interrupt to run on its
matching CPU. No affinity is configured when the interrupts are
registered, so the GIC routes every Rx and Tx completion interrupt to
CPU0 by default.

Build the hash queue map from the configured bitmap and place the Rx and
Tx completion ring interrupts on the CPU each ring serves. Affinity
setup is non-fatal, so failing to steer an interrupt does not prevent
networking from starting.

The affinity is set once, after all interrupts are requested, with
irq_set_affinity_and_hint(): the hint publishes the intended CPU in
/proc/irq/N/affinity_hint, and nothing re-applies the affinity, so
irqbalance or the user can still move the interrupts. The hints are
cleared before the interrupts are freed.

Link: https://github.com/Dedrimer/SBE1V1K/commit/3ee40aeeec0b3f1b0ccb2a32dee2e85af8ce4a11
Signed-off-by: Dedrimer <13420015738@sina.cn>
[Crescentm: map Tx completion rings by index (i % num_possible_cpus())
 like edma_cfg_tx_napi_add() does, Rx rings by index; use
 irq_set_affinity_and_hint() once after registration and clear the hint
 on teardown; build the queue map from the bitmap bits directly]
Signed-off-by: Crescentm <guyues@outlook.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
@@ -7,7 +7,9 @@
   */
 
 #include <linux/clk.h>
+#include <linux/cpumask.h>
 #include <linux/delay.h>
+#include <linux/interrupt.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/netdevice.h>
@@ -361,6 +363,44 @@ static irqreturn_t edma_misc_handle_irq(
 	return IRQ_HANDLED;
 }
 
+/* Steer a ring interrupt to the CPU its ring serves. */
+static void edma_irq_set_cpu(unsigned int irq, unsigned int cpu)
+{
+	int ret;
+
+	if (cpu >= nr_cpu_ids || !cpu_online(cpu))
+		return;
+
+	ret = irq_set_affinity_and_hint(irq, cpumask_of(cpu));
+	if (ret)
+		pr_warn("Failed to set IRQ %u affinity to CPU%u: %d\n",
+			irq, cpu, ret);
+}
+
+/* Initial placement of the ring interrupts.
+ *
+ * Without it the GIC delivers every Rx and Tx completion interrupt to
+ * CPU0. Rx ring i receives the queues that the RPS hash map assigns to
+ * core i, and Tx completion ring i serves the Tx ring used by CPU
+ * (i % num_possible_cpus()), so place each interrupt on that CPU. This
+ * is done once: irqbalance or the user may move the interrupts later,
+ * and the published affinity hint only states the preferred CPU.
+ */
+static void edma_irq_set_affinity(void)
+{
+	struct edma_hw_info *hw_info = edma_ctx->hw_info;
+	struct edma_ring_info *txcmpl = hw_info->txcmpl;
+	struct edma_ring_info *rx = hw_info->rx;
+	u32 i;
+
+	for (i = 0; i < txcmpl->num_rings; i++)
+		edma_irq_set_cpu(edma_ctx->intr_info.intr_txcmpl[i],
+				 i % num_possible_cpus());
+
+	for (i = 0; i < rx->num_rings; i++)
+		edma_irq_set_cpu(edma_ctx->intr_info.intr_rx[i], i);
+}
+
 static int edma_irq_register(void)
 {
 	struct edma_hw_info *hw_info = edma_ctx->hw_info;
@@ -452,6 +492,8 @@ static int edma_irq_register(void)
 		goto misc_intr_req_fail;
 	}
 
+	edma_irq_set_affinity();
+
 	return 0;
 
 misc_intr_req_fail:
@@ -790,6 +832,7 @@ void edma_destroy(struct ppe_device *ppe
 	for (i = 0; i < txcmpl->num_rings; i++) {
 		synchronize_irq(edma_ctx->intr_info.intr_txcmpl[i]);
 
+		irq_update_affinity_hint(edma_ctx->intr_info.intr_txcmpl[i], NULL);
 		free_irq(edma_ctx->intr_info.intr_txcmpl[i],
 			 (void *)&edma_ctx->txcmpl_rings[i]);
 		kfree(edma_txcmpl_irq_name[i]);
@@ -799,6 +842,7 @@ void edma_destroy(struct ppe_device *ppe
 	/* Free IRQ for Rx DESC rings */
 	for (i = 0; i < rx->num_rings; i++) {
 		synchronize_irq(edma_ctx->intr_info.intr_rx[i]);
+		irq_update_affinity_hint(edma_ctx->intr_info.intr_rx[i], NULL);
 		free_irq(edma_ctx->intr_info.intr_rx[i],
 			 (void *)&edma_ctx->rx_rings[i]);
 		kfree(edma_rxdesc_irq_name[i]);
--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
@@ -1000,7 +1000,6 @@ void edma_cfg_rx_napi_add(void)
  */
 int edma_cfg_rx_rps_hash_map(void)
 {
-	cpumask_t edma_rps_cpumask = {{EDMA_RX_DEFAULT_BITMAP}};
 	int map_len = 0, idx = 0, ret = 0;
 	u32 q_off = EDMA_RX_QUEUE_START;
 	u32 q_map[EDMA_MAX_CORE] = {0};
@@ -1010,12 +1009,19 @@ int edma_cfg_rx_rps_hash_map(void)
 	 * rings based on a bitmask, which represents the cores to be mapped.
 	 * These queues are expected to be mapped to different Rx rings
 	 * which are assigned to different cores using IRQ affinity configuration.
+	 * The cores are those set in the rps_bitmap_cores sysctl.
 	 */
-	for_each_cpu(cpu, &edma_rps_cpumask) {
+	for (cpu = 0; cpu < EDMA_MAX_CORE; cpu++) {
+		if (!(edma_cfg_rx_rps_bitmap_cores & BIT(cpu)))
+			continue;
+
 		q_map[map_len] = q_off + (cpu * EDMA_MAX_PRI_PER_CORE);
 		map_len++;
 	}
 
+	if (!map_len)
+		return -EINVAL;
+
 	for (hash = 0; hash < PPE_QUEUE_HASH_NUM; hash++) {
 		ret = ppe_edma_queue_offset_config(edma_ctx->ppe_dev,
 						   PPE_QUEUE_OFFSET_BY_HASH, hash, q_map[idx]);
