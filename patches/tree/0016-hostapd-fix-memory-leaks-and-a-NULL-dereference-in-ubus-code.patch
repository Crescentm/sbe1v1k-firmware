From a242901ad31af2b3f7dd35754df0484f9cc716af Mon Sep 17 00:00:00 2001
From: Matthew Cather <mattbob4@gmail.com>
Date: Tue, 22 Sep 2026 13:49:31 -0700
Subject: [PATCH] hostapd: free the neighbor list in hostapd_bss_tr_send()

hostapd_bss_tr_send() builds the neighbor report list for a BSS
transition request with os_zalloc() and frees it on exactly one path,
when hexstr2bin() rejects an entry. The three MBO validation returns, the
wnm_send_bss_tm_req() failure return and the success path all drop the
pointer.

wnm_send_bss_tm_req() copies the list into its own frame buffer and never
takes ownership, so every bss_transition_request that carries neighbors
leaks one list. One candidate per steer means the leak grows with the
number of steers since boot, which on a busy controller is continuous.

Give the function a single exit that frees it. free() accepts NULL, so
the paths that never allocated are unaffected.

Signed-off-by: Matthew Cather <mattbob4@gmail.com>
Link: https://github.com/openwrt/openwrt/pull/25339
[Crescentm: from OpenWrt PR #25339 head ab8903a1a3fc14df63e3dc064054d9a8a06e27fe,
 commit a242901ad3; unchanged except for line numbers (applied on top of 0014)]
---
 .../services/hostapd/src/src/ap/ubus.c        | 30 ++++++++++++-------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/package/network/services/hostapd/src/src/ap/ubus.c b/package/network/services/hostapd/src/src/ap/ubus.c
index 4dd876a3..a51560ac 100644
--- a/package/network/services/hostapd/src/src/ap/ubus.c
+++ b/package/network/services/hostapd/src/src/ap/ubus.c
@@ -1604,6 +1604,7 @@ hostapd_bss_tr_send(struct hostapd_data *hapd, u8 *addr, bool disassoc_imminent,
 	u8 req_mode = 0;
 	u8 mbo_buf[10];
 	size_t mbo_len = 0;
+	int ret = 0;
 
 	hapd = hostapd_ubus_sta_bss(hapd, addr, &sta);
 	if (!sta)
@@ -1638,8 +1639,8 @@ hostapd_bss_tr_send(struct hostapd_data *hapd, u8 *addr, bool disassoc_imminent,
 			*nr_cur++ = WLAN_EID_NEIGHBOR_REPORT;
 			*nr_cur++ = (u8) len;
 			if (hexstr2bin(blobmsg_data(cur), nr_cur, len)) {
-				free(nr);
-				return UBUS_STATUS_INVALID_ARGUMENT;
+				ret = UBUS_STATUS_INVALID_ARGUMENT;
+				goto out;
 			}
 
 			nr_cur += len;
@@ -1662,16 +1663,22 @@ hostapd_bss_tr_send(struct hostapd_data *hapd, u8 *addr, bool disassoc_imminent,
 	if (mbo) {
 		u8 *mbo_pos = mbo_buf;
 
-		if (mbo_reason > MBO_TRANSITION_REASON_PREMIUM_AP)
-			return UBUS_STATUS_INVALID_ARGUMENT;
+		if (mbo_reason > MBO_TRANSITION_REASON_PREMIUM_AP) {
+			ret = UBUS_STATUS_INVALID_ARGUMENT;
+			goto out;
+		}
 
 		if (cell_pref != MBO_CELL_PREF_EXCLUDED &&
 		    cell_pref != MBO_CELL_PREF_NO_USE &&
-		    cell_pref != MBO_CELL_PREF_USE)
-			return UBUS_STATUS_INVALID_ARGUMENT;
+		    cell_pref != MBO_CELL_PREF_USE) {
+			ret = UBUS_STATUS_INVALID_ARGUMENT;
+			goto out;
+		}
 
-		if (reassoc_delay > 65535 || (reassoc_delay && !disassoc_imminent))
-			return UBUS_STATUS_INVALID_ARGUMENT;
+		if (reassoc_delay > 65535 || (reassoc_delay && !disassoc_imminent)) {
+			ret = UBUS_STATUS_INVALID_ARGUMENT;
+			goto out;
+		}
 
 		*mbo_pos++ = MBO_ATTR_ID_TRANSITION_REASON;
 		*mbo_pos++ = 1;
@@ -1691,11 +1698,14 @@ hostapd_bss_tr_send(struct hostapd_data *hapd, u8 *addr, bool disassoc_imminent,
 	}
 #endif
 
+	/* wnm_send_bss_tm_req() copies the neighbor list into its own frame */
 	if (wnm_send_bss_tm_req(hapd, sta, req_mode, disassoc_timer, validity_period, NULL,
 				dialog_token, NULL, nr, nr_len, mbo_len ? mbo_buf : NULL, mbo_len))
-		return UBUS_STATUS_UNKNOWN_ERROR;
+		ret = UBUS_STATUS_UNKNOWN_ERROR;
 
-	return 0;
+out:
+	free(nr);
+	return ret;
 }
 
