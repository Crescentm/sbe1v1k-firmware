From 6d18f7aff816ce0073e9146c005af9dba3cf30f0 Mon Sep 17 00:00:00 2001
From: Kamil Bienkiewicz <perceivalpercy@gmail.com>
Date: Sun, 30 Aug 2026 09:53:20 +0200
Subject: [PATCH] wifi-scripts: fix macaddr 'random' on MLO interfaces

Setting `option macaddr 'random'` on an MLO wifi-iface (LuCI: Advanced
Settings -> MAC address -> "randomly generated") prevents the AP MLD from
coming up at all:

  hostapd: Failed to create MLD ap-mld0 on phy phy0: Invalid input data or
  parameter: attribute `mac` has invalid value `random`: invalid MAC address

The literal string reaches nl80211 because the MLD netdev is created from the
raw vif config: mlo_vif_create() snapshots the parsed UCI section into
wireless.mlo, which is shipped over ubus (mld_set) to hostapd.uc, where
mld_add_bss() only checks whether the address is empty before passing it to
wdev_add(). That path never runs iface.prepare(), which is the only place
'random' is translated, so the string is forwarded verbatim.

Resolve 'random' in mlo_vif_create() instead, in the main netifd process,
before the config is handed out. Only the MLD snapshot is resolved: the vif
config keeps the literal value, so the link BSS on the first radio still
takes the 'random' branch in iface.prepare() and is marked random_macaddr,
which hostapd.uc needs to reassign the previous BSSID on reload. The
remaining links are unaffected either way, as mlo_vif_macaddr() already
drops their macaddr so they take the default_macaddr path. Doing this here
rather than in hostapd.uc also covers MLO station mode, as wpa_supplicant.uc
carries the same empty-check-only pattern and is fed from the same
wireless.mlo table.

The MLD address is redrawn on each reload, so the MLD is torn down and
recreated and its address changes; persistent addresses remain available via
an explicit macaddr or the factory default.

macaddr_random() moves from iface.uc to wifi/utils.uc so that both callers
share one implementation: iface.uc ships only under CONFIG_WIFI_SCRIPTS_UCODE
and cannot be imported from netifd, while files/usr/share/ucode/wifi/utils.uc
is always installed and already imported here for find_phy().

Tested on two GL.iNet Flint 3 (GL-BE9300, IPQ5332 + QCN6274, ath12k), 2 GHz +
5 GHz + 6 GHz AP MLD. Before the change both fail as above; after it the MLD
comes up with a locally administered address and clients complete SAE.

Signed-off-by: Kamil Bienkiewicz <perceivalpercy@gmail.com>
Link: https://github.com/openwrt/openwrt/pull/24955
[Crescentm: from OpenWrt PR #24955 head 6d18f7aff816ce0073e9146c005af9dba3cf30f0,
 without its Makefile PKG_RELEASE bump (0010/0011 already bump wifi-scripts)]
---
 .../files-ucode/usr/share/ucode/wifi/iface.uc | 12 +----------
 .../wifi-scripts/files/lib/netifd/wireless.uc | 12 ++++++++++-
 .../files/usr/share/ucode/wifi/utils.uc       | 20 ++++++++++++++++++-
 3 files changed, 31 insertions(+), 13 deletions(-)

diff --git a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/iface.uc b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/iface.uc
index 7087095c..01b50208 100644
--- a/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/iface.uc
+++ b/package/network/config/wifi-scripts/files-ucode/usr/share/ucode/wifi/iface.uc
@@ -1,6 +1,7 @@
 'use strict';
 
 import { append_value, log } from 'wifi.common';
+import { macaddr_random } from 'wifi.utils';
 import * as fs from 'fs';
 
 export function parse_encryption(config, dev_config, phy_features) {
@@ -259,17 +260,6 @@ export function wpa_key_mgmt(config, band) {
 	config.key_mgmt = config.wpa_key_mgmt;
 };
 
-function macaddr_random() {
-	let f = fs.open("/dev/urandom", "r");
-	let addr = f.read(6);
-
-	addr = map(split(addr, ""), (v) => ord(v));
-	addr[0] &= ~1;
-	addr[0] |= 2;
-
-	return join(":", map(addr, (v) => sprintf("%02x", v)));
-}
-
 let mac_idx = 0;
 export function prepare(data, phy, num_global_macaddr, macaddr_base) {
 	if (!data.macaddr) {
diff --git a/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc b/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
index 17327213..41878b7c 100644
--- a/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
+++ b/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
@@ -7,7 +7,7 @@ import {
 	parse_attribute_list, parse_bool, parse_array,
 	TYPE_ARRAY, TYPE_STRING, TYPE_INT, TYPE_BOOL
 } from "./utils.uc";
-import { find_phy } from "wifi.utils";
+import { find_phy, macaddr_random } from "wifi.utils";
 import * as wdev from "./wireless-device.uc";
 
 let wireless = netifd.wireless = {
@@ -56,6 +56,16 @@ function mlo_vif_create(config, radio_config, vif_idx, mlo_vifs)
 {
 	let mlo_config = { ...config };
 
+	/*
+	 * The MLD netdev is created by hostapd from this config, which never
+	 * passes through iface.prepare(), so 'random' would reach nl80211
+	 * verbatim and the MLD would fail to come up.  Resolve it here, and
+	 * only for the MLD: the first link BSS keeps the literal value so that
+	 * prepare() draws its address and marks it random_macaddr.
+	 */
+	if (mlo_config.macaddr == 'random')
+		mlo_config.macaddr = macaddr_random();
+
 	if (config.wds)
 		mlo_config['4addr'] = config.wds;
 	mlo_config.radio_config = radio_config;
diff --git a/package/network/config/wifi-scripts/files/usr/share/ucode/wifi/utils.uc b/package/network/config/wifi-scripts/files/usr/share/ucode/wifi/utils.uc
index d5867e11..f7870a6e 100644
--- a/package/network/config/wifi-scripts/files/usr/share/ucode/wifi/utils.uc
+++ b/package/network/config/wifi-scripts/files/usr/share/ucode/wifi/utils.uc
@@ -1,6 +1,6 @@
 'use strict';
 
-import { readfile, realpath, lsdir } from "fs";
+import { open, readfile, realpath, lsdir } from "fs";
 import * as nl80211 from "nl80211";
 
 function phy_filename(phy, name) {
@@ -132,3 +132,21 @@ export function find_phy(config, rename) {
 	       find_phy_by_macaddr(phys, config.macaddr) ??
 	       find_phy_by_name(phys, config.phy, rename);
 };
+
+/* Draw a random, locally administered MAC address. */
+export function macaddr_random() {
+	let f = open("/dev/urandom", "r");
+	if (!f)
+		return null;
+
+	let addr = map(split(f.read(6), ""), (v) => ord(v));
+	f.close();
+
+	if (length(addr) != 6)
+		return null;
+
+	addr[0] &= ~1;
+	addr[0] |= 2;
+
+	return join(":", map(addr, (v) => sprintf("%02x", v)));
+};
